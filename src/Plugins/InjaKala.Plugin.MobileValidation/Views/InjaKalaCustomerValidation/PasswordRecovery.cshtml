@model InjaKalaIR.Plugin.MobileValidation.InjaKalaPasswordRecoveryModel
@using Nop.Web.Models.Customer;
@{
    Layout = "~/Views/Shared/_ColumnsOne.cshtml";

    //title
   NopHtml.AddTitleParts(T("PageTitle.PasswordRecovery").Text);
    //page class
   NopHtml.AppendPageCssClassParts("html-password-recovery-page");
}
<div class="page password-recovery-page">
    <div class="page-title">
        <h1>@T("Account.PasswordRecovery")</h1>
    </div>
    <div class="page-body">
        @if (!String.IsNullOrEmpty(Model.Result))
        {
            <div class="result">
                @Model.Result
            </div>
        }
        @if (ViewBag.SuccessChange == true)
        {
            <input type="button" class="button-1 register-button" onclick="location.href=&quot;/login&quot;" value="ورود به سیستم">
        }
        else
        {
            <form method="post">
                @Html.AntiForgeryToken()
                @if (ViewBag.ShowSectionActiveCode != true)
                {
                    <p class="tooltip">@T("InjaKala.Account.PasswordRecovery.Tooltip")</p>
                    <div class="fieldset">

                        <div id="MobileSection" class="form-fields">
                            <div class="inputs">
                                <label asp-for="Mobile" asp-postfix=":"></label>
                                <input asp-for="Mobile" class="phone" />
                                <nop-required />
                                <span asp-validation-for="Mobile"></span>
                            </div>
                        </div>
                    </div>
                    <div class="buttons">
                        <input type="submit" name="send-email" class="button-1 password-recovery-button" value="@T("Account.PasswordRecovery.RecoverButton")" />
                    </div>
                }
                else
                {
                    <input asp-for="Mobile" type="hidden" class="phone" />
                    <div id="" class="form-fields">
                        <div class="inputs">
                            <label asp-for="Token" asp-postfix=":"></label>
                            <input asp-for="Token" class="Token" type="text" placeholder="کد فعال سازی که برای شما پیامک میشود را اینجا وارد کنید" />

                            <span asp-validation-for="Token"></span>
                        </div>

                        <div class="inputs">
                            <label asp-for="Password" asp-postfix=":"></label>
                            <input asp-for="Password" class="Password" type="password" placeholder="کلمه عبور جدید خود را وارد کنید" />

                            <span asp-validation-for="Password"></span>
                        </div>

                        <div class="inputs">
                            <label asp-for="NewPassword" asp-postfix=":"></label>
                            <input asp-for="NewPassword" class="Password" type="password" placeholder="کلمه عبور خود را مجدد وارد نمایید" />

                            <span asp-validation-for="NewPassword"></span>
                        </div>
                        <div class="buttons">
                            <input type="submit" name="confitm-code" class="button-1 password-recovery-button" value="@T("Account.PasswordRecovery.RecoverButtonConfirm")" />
                            <input type="button" class="button-1 register-button" onclick="location.href=&quot;/passwordrecovery&quot;" value="تغییر شماره">
                        </div>
                    </div>
                }
            </form>
        }
    </div>
</div>