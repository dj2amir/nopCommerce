
@using Nop.Web.Models.Customer;
@{
    
   NopHtml.AppendScriptParts(Nop.Web.Framework.UI.ResourceLocation.Footer, "~/Plugins/InjaKalaIR.Plugin.MobileValidation/script/jquery.maskedinput.min.js");
}

<script asp-location="Footer">
    jQuery(function ($) {
        $.mask.definitions['#'] = '[9-9]';

        $("#Username").mask("0#999999999",
            {
                completed: function () {
                    localStorage.setItem('myPhone', this.val());
                }
            }).attr('dir', 'ltr');
        $("#Username").closest('form')
    });

</script>

<!-- InjaKala Mobile Validation -->